# ==============================================================================
# NutriLens Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholders with your actual credentials.
# NEVER commit .env containing real credentials or secrets to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_API_URL=http://localhost:8000/api/v1

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_APP_URL=http://localhost:3000

# CORS Allowed Origins (Comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-optional
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-offline-token-verification

# USDA FoodData Central API
# Register at: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key_here

# Google Gemini AI (Optional - for AI Chef & Ingredient Label Scanner)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Machine Learning Model Configuration
MODEL_PATH=./models/food_model.onnx
CLASS_NAMES_PATH=./models/class_names.json
# Optional remote URL to download trained food model binary if not present locally
MODEL_DOWNLOAD_URL=
